{
  "name": "FundClone",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "streamlit_app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip install --user -e '.[app,dev]'",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "FundClone",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
